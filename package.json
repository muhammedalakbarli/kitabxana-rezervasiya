{
  "name": "qu-kitabxana-rezervasiya",
  "version": "1.0.0",
  "private": true,
  "description": "Qarabağ Universiteti Kitabxanası — fərdi oxu otaqları və avadanlıq rezervasiya sistemi",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:scripts": "esbuild scripts/worker.ts prisma/seed.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist --external:@prisma/client --log-level=warning",
    "start": "next start -p 3000",
    "worker": "node dist/scripts/worker.js",
    "worker:dev": "tsx --env-file=.env scripts/worker.ts",
    "db:start": "bash scripts/dev-db.sh start",
    "db:stop": "bash scripts/dev-db.sh stop",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://kitabxana@localhost:5434/kitabxana_test} prisma migrate deploy && vitest run --config vitest.integration.mts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts --if-empty && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.73.0",
    "next": "^15.5.29",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
