# ── Baza ───────────────────────────────────────────────────────────────
# PostgreSQL (tövsiyə olunur). Lokal: npm run db:start
DATABASE_URL="postgresql://kitabxana@localhost:5434/kitabxana"

# ── Tətbiq ─────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Uzun təsadüfi sətir: openssl rand -hex 32
AUTH_SECRET="change-me"
# Giriş icazəli domenlər (vergüllə)
ALLOWED_EMAIL_DOMAINS="qu.edu.az"
# İlk girişdə avtomatik ADMIN rolu alacaq e-poçtlar (vergüllə)
ADMIN_EMAILS=""
# Fon tapşırıqları üçün endpoint açarı (/api/cron?key=...)
CRON_SECRET="change-me-too"
# Yüklənən fotoların saxlandığı qovluq
STORAGE_DIR="./storage"

# ── E-poçt / Outlook təqvim dəvətləri ──────────────────────────────────
# MAIL_MODE=smtp → real göndərmə; MAIL_MODE=log → yalnız jurnala yazılır (inkişaf)
MAIL_MODE="log"
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="QU Kitabxana <kitabxana@qu.edu.az>"
# Yalnız inkişaf/demo: /dev/poct səhifəsində göndərilən məktublar (giriş kodları da) görünür.
# DİQQƏT: real istifadədə mütləq "false" olmalıdır!
DEV_MAILBOX="false"
# İctimai demo serverində test poçtunu qorumaq üçün: /dev/poct?key=<bu dəyər>
DEV_MAILBOX_KEY=""

# ── Microsoft 365 (Entra ID) ilə giriş — rəqəmsal şöbə doldurur ─────────
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""

# ── QR təsdiqi üçün şəbəkə məhdudiyyəti (boş = söndürülüb) ──────────────
# Məs: "10.0.0.0/8,192.168.0.0/16"
CHECKIN_ALLOWED_CIDRS=""
